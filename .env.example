# Copy to .env. Never commit the real .env.
REAPER_DEBUG=true
APP_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to APP_URL. Comma-separated origins only (no paths); whitespace is trimmed.
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Production public origin (use these values in Azure, not the internal Azure URL):
# APP_URL=https://reporeaper.oddware.dev
# ALLOWED_HOSTS=reporeaper.oddware.dev
# CSRF_TRUSTED_ORIGINS=https://reporeaper.oddware.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# First key encrypts new data; subsequent comma-separated keys can decrypt old data.
TOKEN_ENCRYPTION_KEYS=
# Local SQLite fallback if omitted. PostgreSQL required for production/multiple workers.
# DATABASE_URL=postgresql://reaper:password@localhost:5432/reaper
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Users add their own encrypted OpenAI API key in Settings.
# Operator-controlled allowlist. Select a structured-output-capable model.
AI_MODELS=gpt-4.1-mini
DAILY_SCAN_LIMIT=50
# Set true behind Azure Container Apps HTTP ingress, which overwrites X-Forwarded-Proto.
# Otherwise enable only behind a proxy that strips and replaces that header.
TRUST_PROXY=false
# Docker Compose database password (required by Compose).
POSTGRES_PASSWORD=

# Optional House Edge browser analytics. Public ingestion values only.
# Set enabled=true explicitly for this deployment; restart after changes.
HOUSE_EDGE_ENABLED=false
HOUSE_EDGE_PROJECT=repo-reaper
HOUSE_EDGE_KEY=
HOUSE_EDGE_ENDPOINT=
